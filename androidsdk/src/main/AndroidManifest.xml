<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Screenshot sharing: Android 14+ reports that a screenshot was taken, without its image. Granted at install. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <application>
        <!-- Serves the article image previewed in the screenshot share sheet. -->
        <provider
            android:name="com.envoy.androidsdk.screenshot.EnvoyFileProvider"
            android:authorities="${applicationId}.envoy.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/envoy_file_paths" />
        </provider>
    </application>

</manifest>